<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CSS Grid Layout</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #f1f5f9;
            padding: 30px;
        }

        .container {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            grid-template-rows: 100px 200px 200px 100px;
            gap: 10px;
            max-width: 1200px;
            margin: auto;
        }

        .box {
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 25px;
            font-weight: bold;
            border-radius: 10px;
            transition: 0.3s ease;
        }

        .box:hover {
            transform: scale(1.02);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
        }

        /* Header */
        .header {
            grid-column: 1 / 5;
            background-color: #1e293b;
            color: #ffffff;
        }

        /* Sidebar */
        .sidebar {
            grid-column: 1 / 2;
            grid-row: 2 / 4;
            background-color: #bae6fd;
            color: #075985;
        }

        /* Title */
        .title {
            grid-column: 2 / 5;
            background-color: #ddd6fe;
            color: #5b21b6;
        }

        /* Articles */
        .article1 {
            grid-column: 2 / 3;
            background-color: #bbf7d0;
            color: #166534;
        }

        .article2 {
            grid-column: 3 / 4;
            background-color: #fed7aa;
            color: #9a3412;
        }

        .article3 {
            grid-column: 4 / 5;
            background-color: #fbcfe8;
            color: #9d174d;
        }

        /* Footer */
        .footer {
            grid-column: 1 / 5;
            background-color: #0f172a;
            color: #ffffff;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            body {
                padding: 15px;
            }

            .container {
                grid-template-columns: repeat(2, 1fr);
                grid-template-rows: 80px 150px 150px 150px 150px 80px;
            }

            .header {
                grid-column: 1 / 3;
            }

            .sidebar {
                grid-column: 1 / 3;
                grid-row: auto;
            }

            .title {
                grid-column: 1 / 3;
            }

            .article1,
            .article2 {
                grid-column: auto;
            }

            .article3 {
                grid-column: 1 / 3;
            }

            .footer {
                grid-column: 1 / 3;
            }
        }

        @media (max-width: 480px) {
            .container {
                display: flex;
                flex-direction: column;
            }

            .box {
                min-height: 100px;
                font-size: 20px;
            }

            .sidebar {
                min-height: 150px;
            }

            .title {
                min-height: 150px;
            }

            .article1,
            .article2,
            .article3 {
                min-height: 150px;
            }
        }
    </style>
</head>

<body>

    <div class="container">

        <header class="box header">
            Header
        </header>

        <aside class="box sidebar">
            Sidebar
        </aside>

        <section class="box title">
            Title
        </section>

        <article class="box article1">
            Article 1
        </article>

        <article class="box article2">
            Article 2
        </article>

        <article class="box article3">
            Article 3
        </article>

        <footer class="box footer">
            Footer
        </footer>

    </div>

</body>
</html>
